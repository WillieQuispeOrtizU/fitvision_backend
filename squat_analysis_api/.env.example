# Copy this file to .env and edit the values for your machine.
#
# Usage:
#   cp .env.example .env
#   set -a
#   source .env
#   set +a

# Local assistant server bind address.
SQUAT_ASSISTANT_HOST=127.0.0.1
SQUAT_ASSISTANT_PORT=7862
SQUAT_ASSISTANT_URL=http://127.0.0.1:7862

# Lightweight upload API server bind address.
SQUAT_ANALYSIS_API_HOST=127.0.0.1
SQUAT_ANALYSIS_API_PORT=8000
SQUAT_ANALYSIS_JOBS_DIR=jobs
SQUAT_ANALYSIS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Job directories older than this many hours are deleted on server start.
# Set to 0 to disable cleanup. Job status survives restarts (persisted to disk).
SQUAT_ANALYSIS_JOBS_TTL_HOURS=24

# Existing PostgreSQL database used by authentication and persistence.
# The application never creates tables; provision them separately with the
# schema already used by the deployment.
DATABASE_URL=postgresql+psycopg://fitvision:change-me@127.0.0.1:5432/fitvision
# Bearer-session lifetime in hours (defaults to 30 days when omitted/invalid).
AUTH_SESSION_TTL_HOURS=720

# Password recovery (development/local until the public API uses HTTPS).
# Generate a unique random value of at least 32 bytes; never commit the real
# value. Codes and email/IP fingerprints are stored only as HMAC-SHA-256.
PASSWORD_RESET_PEPPER=
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_TOKEN_TTL_SECONDS=600
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600
PASSWORD_RESET_MAX_REQUESTS_PER_EMAIL=5
PASSWORD_RESET_MAX_REQUESTS_PER_IP=20
PASSWORD_RESET_MAX_ATTEMPTS=5
# Only list reverse proxies that overwrite X-Forwarded-For. Leave empty for a
# directly exposed local server. Typical same-host Nginx values: 127.0.0.1,::1
PASSWORD_RESET_TRUSTED_PROXY_IPS=

# Replaceable email provider. The initial implementation supports SMTP.
PASSWORD_RESET_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls or ssl for real providers. plain is accepted only for an
# unauthenticated loopback SMTP test server (for example, local Mailpit).
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FitVision
SMTP_TIMEOUT_SECONDS=15

# Client timeout for a full assistant analysis request.
# First model load/generation on Apple Silicon can take several minutes.
SQUAT_ASSISTANT_CLIENT_TIMEOUT=600

# Assistant inference tuning (lower = faster, less visual context).
# Number of representative key frames Falcon/Gemma run on, and the object
# queries Falcon detects per frame. Set WARMUP=1 to load models at server
# startup so the first request does not pay the model-load cost.
SQUAT_ASSISTANT_DETECT_FRAME_LIMIT=4
SQUAT_ASSISTANT_DETECT_QUERIES=person,barbell,dumbbell
SQUAT_ASSISTANT_VLM_IMAGE_LIMIT=1
SQUAT_ASSISTANT_WARMUP=0

# Falcon model used for visual grounding.
# Apple Silicon uses the MLX Falcon adapter automatically.
# Linux/CUDA uses the Torch Falcon adapter automatically.
SQUAT_ASSISTANT_FALCON_MODEL=tiiuae/Falcon-Perception-300M

# Gemma model used for coaching feedback.
# macOS Apple Silicon: use an MLX-compatible model id or local MLX model folder.
SQUAT_ASSISTANT_VLM_MODEL=mlx-community/gemma-4-e4b-it-8bit
# Recommended local path after running:
#   uv run squat-assistant-download
# SQUAT_ASSISTANT_VLM_MODEL=/Users/dele/Documents/Projects/Willie_TP/squat_analysis_api/assistant_models/mlx-community__gemma-4-e4b-it-8bit
#
# Windows/Linux Torch path: use a Transformers-compatible model id or local HF folder.
# SQUAT_ASSISTANT_VLM_MODEL=google/gemma-4-E4B-it

# Optional Falcon tuning.
FALCON_MLX_DTYPE=float16
# Recommended local path after running:
#   uv run squat-assistant-download
# FALCON_HF_LOCAL_DIR=/Users/dele/Documents/Projects/Willie_TP/squat_analysis_api/assistant_models/tiiuae__Falcon-Perception-300M

# Optional Torch/CUDA-only tuning.
# CUDA_DEVICE=cuda:0
# FALCON_TORCH_DTYPE=bfloat16
# FALCON_TORCH_COMPILE=0
